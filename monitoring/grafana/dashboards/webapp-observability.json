{
  "uid": "webapp-obsv-merged",
  "title": "Web App Observability - RED, System, Tracing",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request Rate (RPS, by route)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum(rate(http_requests_total[5m])) by (route)", "legendFormat": "{{route}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate (by route)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "sum(rate(http_errors_total[5m])) by (route)", "legendFormat": "{{route}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "95th Percentile Latency (by route)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}", "exemplar": true}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "timeseries",
      "title": "Aggregate Request Latency (p50/p90/p99)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "exemplar": true},
        {"expr": "histogram_quantile(0.9, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p90", "exemplar": true},
        {"expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "exemplar": true}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "timeseries",
      "title": "Aggregate Error Rate %",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "((sum(rate(http_errors_total[5m])) OR on() vector(0)) / clamp_min(sum(rate(http_requests_total[5m])), 1e-9)) * 100", "legendFormat": "Error %"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "type": "timeseries",
      "title": "Aggregate Requests per Second (RPS)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "sum(rate(http_requests_total[5m]))", "legendFormat": "RPS"}
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage (%)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {"expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU %"}
      ],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "type": "timeseries",
      "title": "Memory Usage (MB)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [
        {"expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / 1024 / 1024", "legendFormat": "Used Memory"}
      ],
      "fieldConfig": {"defaults": {"unit": "megabytes", "decimals": 0}}
    },
    {
      "type": "table",
      "title": "Recent Error Traces",
      "description": "Last 10 traces with error=true in the selected time range. An empty table means no errors observed — this is the desired state. Click a row to open the trace in Jaeger.",
      "id": 9,
      "pluginVersion": "11.1.0",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 32},
      "datasource": {"type": "jaeger", "uid": "jaeger"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "jaeger", "uid": "jaeger"},
          "queryType": "search",
          "service": "advanced-monitoring-webapp",
          "tags": "error=true",
          "limit": 10
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": ["sum"],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"},
            "inspect": false
          },
          "links": [
            {
              "targetBlank": true,
              "title": "View Trace in Jaeger",
              "url": "/jaeger/trace/${__data.fields.traceID}"
            }
          ]
        },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["observability", "tracing", "RED", "system"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {},
  "title": "Web App Observability - RED, System, Tracing",
  "weekStart": ""
}
